<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # No reescribir archivos ni carpetas que existan de verdad
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Cualquier otra ruta -> index.html (Angular se encarga del routing)
  RewriteRule ^ index.html [L]
</IfModule>

# Cache: los assets con hash pueden cachearse mucho tiempo...
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# ...pero index.html NUNCA se cachea, para que siempre sirva el último build
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Compresión gzip de los recursos de texto (reduce mucho el peso del JS)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cabeceras de seguridad básicas
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Solo se puede mostrar dentro de la propia web y de danieldiaz.es (danielOS)
  Header always unset X-Frame-Options
  Header always set Content-Security-Policy "frame-ancestors 'self' https://danieldiaz.es https://*.danieldiaz.es"
</IfModule>
