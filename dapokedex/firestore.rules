rules_version = '2';

// Reglas sugeridas para Dapokedex. Firebase no las lee de este archivo: hay que
// copiarlas en Firebase Console → Firestore Database → Reglas (o desplegarlas
// con la CLI de Firebase). Revisa antes que la parte de /users coincide con lo
// que ya tienes publicado.
service cloud.firestore {
  match /databases/{database}/documents {

    // Datos privados de cada usuario: favoritos, colección, equipo, progreso
    // y mochila. Cada usuario solo lee y escribe su propio documento.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidBag();
    }

    // Ranking: cualquier usuario con sesión puede verlo y cada uno solo
    // escribe su propia fila. Esto frena las trampas más obvias; para
    // impedirlas del todo la XP tendría que calcularse en el servidor
    // (Cloud Functions), porque el progreso lo escribe el propio cliente.
    match /leaderboard/{board}/players/{userId} {
      allow read: if request.auth != null;

      // Semanal: se suma con increment(), así que cada escritura solo puede
      // añadir lo que da una partida.
      allow create: if board != 'alltime' && isOwner(userId) && isValidEntry()
        && request.resource.data.xp <= maxGainPerWrite();
      allow update: if board != 'alltime' && isOwner(userId) && isValidEntry()
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp - resource.data.xp <= maxGainPerWrite();

      // Histórico: guarda el total, que nunca puede superar la XP del progreso
      // del jugador. No se limita el salto para que, si alguna escritura falla,
      // la siguiente pueda ponerse al día en lugar de quedar bloqueada.
      allow create, update: if board == 'alltime' && isOwner(userId) && isValidEntry()
        && (resource == null || request.resource.data.xp >= resource.data.xp)
        && request.resource.data.xp <= progressXp(userId);
    }

    // --- Amigos -------------------------------------------------------------
    // Nadie lee el documento privado de otro: solo su perfil público, que el
    // propio jugador publica al elegir un nombre de usuario.

    // Nombre de usuario → uid. El id del documento es el nombre, así que dos
    // jugadores no pueden tener el mismo. Cada uno solo puede reservar el que
    // pone en su perfil y solo puede soltar el suyo.
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && name.matches('^[a-z0-9_]{3,16}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(profilePath(request.auth.uid)).data.username == name;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && (!existsAfter(profilePath(request.auth.uid))
          || getAfter(profilePath(request.auth.uid)).data.username != name);
    }

    // Perfil público: nombre, título, nivel, equipo y cuántos Pokémon y
    // logros tiene. Lo lee cualquiera con sesión; solo lo escribe su dueño.
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isOwner(userId) && isValidProfile(userId);
      allow delete: if isOwner(userId);
    }

    // Solicitud de amistad pendiente. El id es "deQuién_aQuién"; la ven y la
    // pueden borrar (cancelar o rechazar) los dos implicados.
    match /friendRequests/{id} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if request.auth != null && isValidRequest(id);
      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // Amistad aceptada: un documento por pareja con los dos uid ordenados.
    // Solo se crea si el otro te había enviado una solicitud, y cualquiera de
    // los dos puede borrarla.
    match /friendships/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && isValidFriendship(id);
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // Combates en línea entre amigos. Solo los dos jugadores ven la partida.
    // Cada uno pone su equipo una vez y el registro de turnos solo crece; el
    // resultado lo calcula cada navegador, así que entre amigos se confía en
    // él (para impedir trampas haría falta resolverlo en Cloud Functions).
    match /battles/{id} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.host || request.auth.uid == resource.data.guest);
      allow create: if request.auth != null && isValidChallenge();
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.host || request.auth.uid == resource.data.guest)
        && isValidBattleUpdate();
    }

    function isValidChallenge() {
      let data = request.resource.data;
      let me = request.auth.uid;
      return data.keys().hasOnly(['host', 'guest', 'hostName', 'guestName', 'status', 'seed',
          'hostTeam', 'guestTeam', 'log', 'pending', 'deadline', 'winner', 'reason',
          'createdAt', 'updatedAt'])
        && data.host == me
        && data.guest is string && data.guest != me
        && data.hostName is string && data.hostName.size() <= 16
        && data.guestName is string && data.guestName.size() <= 16
        && data.status == 'pending'
        && data.seed is int
        && data.hostTeam == null && data.guestTeam == null
        && data.log is list && data.log.size() == 0
        && data.deadline is int
        && data.createdAt == request.time
        && exists(/databases/$(database)/documents/friendships/$(pairId(me, data.guest)));
    }

    function isValidBattleUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let me = request.auth.uid;
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly(['hostTeam', 'guestTeam', 'status', 'log', 'pending', 'deadline',
          'winner', 'reason', 'updatedAt'])
        // Cada uno pone solo su equipo, una única vez y de hasta 6 Pokémon.
        && (!changed.hasAny(['hostTeam'])
          || (me == before.host && before.hostTeam == null && after.hostTeam.size() <= 6))
        && (!changed.hasAny(['guestTeam'])
          || (me == before.guest && before.guestTeam == null && after.guestTeam.size() <= 6))
        // El registro de turnos nunca se reescribe hacia atrás.
        && after.log.size() >= before.log.size() && after.log.size() <= 600
        && isValidStatusChange(before.status, after.status, me == before.host, me == before.guest)
        && (after.winner == null || after.winner in ['host', 'guest', 'draw']);
    }

    function isValidStatusChange(before, after, isHost, isGuest) {
      return (before == after && before in ['pending', 'active'])
        || (before == 'pending' && after in ['active', 'declined'] && isGuest)
        || (before == 'pending' && after == 'cancelled' && isHost)
        || (before == 'active' && after == 'finished');
    }

    function profilePath(userId) {
      return /databases/$(database)/documents/profiles/$(userId);
    }

    function isValidProfile(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['username', 'title', 'level', 'xp', 'team',
          'collectionCount', 'achievements', 'lastSeen'])
        && data.username is string && data.username.matches('^[a-z0-9_]{3,16}$')
        && getAfter(/databases/$(database)/documents/usernames/$(data.username)).data.uid == userId
        && data.title is string && data.title.size() <= 40
        && data.level is int && data.level >= 1 && data.level <= 100
        && data.xp is int && data.xp >= 0 && data.xp <= progressXp(userId)
        && data.team is list && data.team.size() <= 6
        && data.collectionCount is int && data.collectionCount >= 0 && data.collectionCount <= 2000
        && data.achievements is int && data.achievements >= 0 && data.achievements <= 200
        && data.lastSeen == request.time;
    }

    function isValidRequest(id) {
      let data = request.resource.data;
      let me = request.auth.uid;
      return data.keys().hasOnly(['from', 'to', 'fromName', 'toName', 'createdAt'])
        && data.from == me
        && data.to is string && data.to != me
        && id == me + '_' + data.to
        && data.fromName is string && data.fromName.size() <= 16
        && data.toName is string && data.toName.size() <= 16
        && data.createdAt == request.time
        && exists(profilePath(me))
        && exists(profilePath(data.to))
        && !exists(/databases/$(database)/documents/friendships/$(pairId(me, data.to)));
    }

    function isValidFriendship(id) {
      let data = request.resource.data;
      let me = request.auth.uid;
      let other = data.users[0] == me ? data.users[1] : data.users[0];
      return data.keys().hasOnly(['users', 'since'])
        && data.users is list && data.users.size() == 2
        && me in data.users
        && data.users[0] < data.users[1]
        && id == data.users[0] + '_' + data.users[1]
        && data.since == request.time
        && exists(/databases/$(database)/documents/friendRequests/$(other + '_' + me));
    }

    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function progressXp(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data
        .get('progress', {}).get('xp', 0);
    }

    // La mochila solo admite objetos que existen en el juego y como mucho 6
    // equipados (uno por Pokémon del equipo). No impide del todo las trampas:
    // el cliente escribe sus propios datos, igual que la XP o la colección.
    function isValidBag() {
      let data = request.resource.data;
      return (!('bag' in data) || (data.bag is map && data.bag.keys().hasOnly(heldItems())))
        && (!('held' in data) || (data.held is map && data.held.size() <= 6));
    }

    function heldItems() {
      return [
        'leftovers', 'black-sludge', 'sitrus-berry', 'oran-berry', 'choice-band',
        'choice-specs', 'choice-scarf', 'life-orb', 'focus-sash', 'expert-belt',
        'muscle-band', 'wise-glasses', 'assault-vest', 'rocky-helmet', 'quick-claw',
        'scope-lens', 'shell-bell', 'charcoal', 'mystic-water', 'magnet', 'miracle-seed',
        'never-melt-ice', 'black-belt', 'poison-barb', 'soft-sand', 'sharp-beak',
        'twisted-spoon', 'silver-powder', 'hard-stone', 'spell-tag', 'dragon-fang',
        'black-glasses', 'metal-coat', 'silk-scarf', 'fairy-feather', 'lum-berry',
        'cheri-berry', 'chesto-berry', 'pecha-berry', 'rawst-berry', 'aspear-berry',
        'persim-berry', 'damp-rock', 'heat-rock', 'smooth-rock', 'icy-rock'
      ];
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Una victoria con todos los extras (bonus, shinies, retos, racha) no
    // llega a esta cifra.
    function maxGainPerWrite() {
      return 2500;
    }

    function isValidEntry() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'title', 'level', 'xp', 'updatedAt'])
        && data.name is string && data.name.size() <= 30
        && data.title is string && data.title.size() <= 40
        && data.level is int && data.level >= 1 && data.level <= 100
        && data.xp is int && data.xp >= 0
        && data.updatedAt == request.time;
    }
  }
}
