rules_version = '2';

// Reglas sugeridas para Dapokedex. Firebase no las lee de este archivo: hay que
// copiarlas en Firebase Console → Firestore Database → Reglas (o desplegarlas
// con la CLI de Firebase). Revisa antes que la parte de /users coincide con lo
// que ya tienes publicado.
service cloud.firestore {
  match /databases/{database}/documents {

    // Datos privados de cada usuario: favoritos, colección, equipo y progreso.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Ranking: cualquier usuario con sesión puede verlo y cada uno solo
    // escribe su propia fila. Esto frena las trampas más obvias; para
    // impedirlas del todo la XP tendría que calcularse en el servidor
    // (Cloud Functions), porque el progreso lo escribe el propio cliente.
    match /leaderboard/{board}/players/{userId} {
      allow read: if request.auth != null;

      // Semanal: se suma con increment(), así que cada escritura solo puede
      // añadir lo que da una partida.
      allow create: if board != 'alltime' && isOwner(userId) && isValidEntry()
        && request.resource.data.xp <= maxGainPerWrite();
      allow update: if board != 'alltime' && isOwner(userId) && isValidEntry()
        && request.resource.data.xp >= resource.data.xp
        && request.resource.data.xp - resource.data.xp <= maxGainPerWrite();

      // Histórico: guarda el total, que nunca puede superar la XP del progreso
      // del jugador. No se limita el salto para que, si alguna escritura falla,
      // la siguiente pueda ponerse al día en lugar de quedar bloqueada.
      allow create, update: if board == 'alltime' && isOwner(userId) && isValidEntry()
        && (resource == null || request.resource.data.xp >= resource.data.xp)
        && request.resource.data.xp <= progressXp(userId);
    }

    function progressXp(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.progress.xp;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Una victoria con todos los extras (bonus, shinies, retos, racha) no
    // llega a esta cifra.
    function maxGainPerWrite() {
      return 2500;
    }

    function isValidEntry() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'title', 'level', 'xp', 'updatedAt'])
        && data.name is string && data.name.size() <= 30
        && data.title is string && data.title.size() <= 40
        && data.level is int && data.level >= 1 && data.level <= 100
        && data.xp is int && data.xp >= 0
        && data.updatedAt == request.time;
    }
  }
}
